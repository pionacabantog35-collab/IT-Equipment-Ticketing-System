 .body {
        font-family: 'sans-serif;', sans-serif;
        margin: 0;
        padding: 0;
        background-color: #f4f4f4;
        display: flex;
    }

   .sidebar {
    width: 250px;
    height: 100vh;
    background-color: #3D59AB;
    color: white;
    position: fixed;
    left: 0;
    top: 0;
    padding-top: 20px;
    }

    .sidebar ul {
        list-style: none;
        padding: 0;
    }

    .sidebar ul li {
        padding: 10px;
        text-align: center;
    }

    .sidebar ul li a {
        color: white;
        text-decoration: none;
        display: block;
        padding: 10px;
    }

    .sidebar ul li a:hover {
        background-color: #ff5722;
    }

    /* Header */
    .header-container {
        position: fixed;
        top: 0;
        left: 250px;
        width: calc(100% - 250px);
        padding: 15px;
        background-color: #004999;
        color: white;
        display: flex;
        align-items: center;
        justify-content: space-between;
        z-index: 1000;
    }

    .header-container h1 {
        margin: 0;
          margin-left: 15px;
          color: white;
    }
    .search-container {
        display: flex;
        align-items: center;
         gap: 5px;
        margin-right: 15px;
    }

    .search-container input[type="text"] {
        padding: 8px;
        margin-right: 15px;
        width: 200px;
        border: none;
        border-radius: 4px;
    }

    .search-container input[type="submit"] {
        padding: 8px 12px;
        margin-right: 15px;
        background-color: #ff5722;
        color: white;
        border: none;
        cursor: pointer;
    }

    .search-container input[type="submit"]:hover {
        background-color: #e64a19;
        margin-right: 15px;
    }